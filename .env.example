# Rezeptbuch Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (SQLite - path is relative to server/src/)
# DB_PATH=../data/recipes.db

# LLM Configuration (optional - for AI features)
# Leave empty to use Ollama locally, or fill in API keys for cloud providers
# Provider options: ollama, openrouter, openai, anthropic, gemini, minimax, custom

# Ollama (local)
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=AIza...

# MiniMax
# MINIMAX_API_KEY=...
# MINIMAX_MODEL=MiniMax-Text-01

# Custom OpenAI-compatible endpoint
# CUSTOM_ENDPOINT=http://localhost:11434/v1/chat/completions
# CUSTOM_API_KEY=
# CUSTOM_MODEL=llama3.2